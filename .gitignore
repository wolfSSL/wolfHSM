.DS_Store
# Test/benchmark object dirs. Negate tools/sbom/build/ — bare Build/
# also matches that path on case-insensitive filesystems (macOS).
Build/
!tools/sbom/build/
!tools/sbom/build/**
*.o
*.a
*.la
**/.gdb_history
tools/testcertgen/ca/
tools/testcertgen/*.der
*.code-workspace
.vscode
compile_commands.json
**/.cache

# Static analysis
tools/static-analysis/reports/
*.xml
*.html

# Code coverage
*.gcda
*.gcno
coverage/
scan_out/*

# Test output
test-suite.log

# SBOM outputs and wolfGlass temp source lists
*.cdx.json
*.spdx.json
*.spdx
.*-wolfglass-srcs.txt
.sbom-wolfhsm-defines.h
