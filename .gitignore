.DS_Store
Build/
# tools/sbom/build is the vendored Make fragment. Build/ matches it
# on a case-insensitive file system.
!tools/sbom/build/
!tools/sbom/build/**
*.o
*.a
*.la
**/.gdb_history
tools/testcertgen/ca/
tools/testcertgen/*.der
*.code-workspace
.vscode
compile_commands.json
.*-wolfssl-compliance-tooling-srcs.txt
wolfhsm-*.cdx.json
wolfhsm-*.spdx.json
wolfhsm-*.spdx
**/.cache

# Static analysis
tools/static-analysis/reports/
*.xml
*.html

# Code coverage
*.gcda
*.gcno
coverage/
scan_out/*

# Test output
test-suite.log
